# Claudiverse production env — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored-by-pattern? NO — add it to .gitignore (this file already
# does). Never commit a real .env / real SECRET_KEY_BASE.

# ---- Server (Phoenix API) ----

# REQUIRED. Generate with:  mix phx.gen.secret   (or: openssl rand -base64 48)
# Must be >= 64 bytes of entropy. Placeholder below is NOT secure.
SECRET_KEY_BASE=replace_me_with_mix_phx_gen_secret_at_least_64_chars_long_xxxxxxxxxxxx

# Public hostname the API is reached at (no scheme). Used for URL generation.
PHX_HOST=localhost

# Port the API listens on AND is published on the host. Pick anything free;
# the dev stack (docker-compose.yml) uses 4000.
PORT=4000

# Public URL scheme/port. Behind a TLS-terminating proxy set PHX_SCHEME=https
# and PHX_URL_PORT=443. For plain HTTP, leave these as-is (PHX_URL_PORT defaults
# to PORT).
PHX_SCHEME=http
# PHX_URL_PORT=4000

# WebSocket/LiveView origin check. The SPA talks cross-origin, so default false.
# Tighten with a comma-separated allowlist, e.g. https://app.example.com
CHECK_ORIGIN=false

# DB connection pool size (SQLite — keep small).
POOL_SIZE=5

# NOTE on auth: there is NO server-side bearer-token env var. API tokens are
# DB-backed. The first account is created in the web panel with the setup code
# the server logs; a machine's tokens come from
#   docker compose -f compose.prod.yml exec server \
#     bin/claudiverse_server eval 'ClaudiverseServer.Release.connect_machine("you@example.com","my-laptop")'
# (see docs/guide/3-machine.md).

# ---- Web (Vite SPA) ----

# COMPILE-TIME build arg: the public URL of the API as the BROWSER will reach
# it (not the in-cluster name). Baked into the JS bundle at build time, so a
# change requires a rebuild of the web image.
VITE_API_URL=http://localhost:4000

# Host port the web SPA is published on.
WEB_PORT=8080

# ---- Anthropic account pool (AnthropicAuths) ----
#
# Encrypts the stored OAuth tokens (access + refresh) at rest with AES-256-GCM.
# Generate:  openssl rand -base64 32
#
# OPTIONAL. Leave unset and the pool is inert: the panel reports "vault not
# configured" and refuses to store accounts. It NEVER stores tokens unencrypted.
#
# ⚠️ NOT RECOVERABLE. If this changes, every stored token becomes undecryptable
# and both accounts need re-enrolling through the panel. Keep it with the rest
# of your server secrets.
CV_VAULT_KEY=

# Background usage poll. This is also how a rate limit gets noticed at all —
# seats run stock and cannot report a 429 back themselves.
#   CV_USAGE_POLL=0        disable entirely
#   CV_USAGE_POLL_MS       interval, minimum 30000, default 300000 (5 min)
#   CV_USAGE_COOLDOWN_PCT  cool an account down at/above this percent (default 95)
CV_USAGE_POLL=1
CV_USAGE_POLL_MS=300000
CV_USAGE_COOLDOWN_PCT=95
